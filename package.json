{
  "name": "miga",
  "version": "0.0.0",
  "private": true,
  "description": "Miga — social food app to save, rate and choose restaurants, bars and cafés with your friends.",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @miga/shared build && pnpm --recursive --parallel dev",
    "build": "pnpm --recursive build",
    "test": "pnpm --filter @miga/shared build && pnpm --filter @miga/api exec prisma generate && vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm --filter @miga/shared build && pnpm --filter @miga/api exec prisma generate && vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @miga/shared build && pnpm --recursive typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
