# Copy this file to .env and fill in real values: cp .env.example .env
# .env is ignored by Git. Never commit real credentials.

# --- Database (PostgreSQL) ---
POSTGRES_USER=miga
POSTGRES_PASSWORD=change-me
POSTGRES_DB=miga

# Used by the API and Prisma when running outside Docker (pnpm dev).
# Inside Docker Compose the host is overridden to "db".
DATABASE_URL=postgresql://miga:change-me@localhost:5432/miga

# --- API ---
API_PORT=3000
JWT_SECRET=change-me-to-a-long-random-string

# --- Web server (nginx, HTTPS) ---
HTTPS_PORT=8443
