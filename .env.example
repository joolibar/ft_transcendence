# Copy this file to .env and fill in real values: cp .env.example .env
# .env is ignored by Git. Never commit real credentials.

# --- Database (PostgreSQL) ---
POSTGRES_USER=miga
POSTGRES_PASSWORD=change-me
POSTGRES_DB=miga

# Used by the API, Prisma and the tests when running outside Docker
# (pnpm dev, pnpm test) against the database started with `make db`.
# Inside Docker Compose the host is overridden to "db".
DATABASE_URL=postgresql://miga:change-me@localhost:5432/miga

# --- API ---
API_PORT=3000

# --- Web server (nginx, HTTPS) ---
HTTPS_PORT=8443
